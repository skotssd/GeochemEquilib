    "\n",
    "sigma = std(Z);\n",
    "\n",
    "D = diag(1./sigma);\n",
    "\n",
    "Zscaled = Z*D;\n",
    "\n",
    "\n",
    "errorCriterion = det(Zscaled'*Zscaled);\n",
    "size(Z)\n",
    "size(data)\n",
    "data(1:5,:)\n",
    "errorCriterion\n",
    "Z\n"
